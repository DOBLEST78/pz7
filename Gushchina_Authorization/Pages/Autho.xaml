<Page x:Class="Gushchina_Authorization.Pages.Autho"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Авторизация"
      Background="#F2F7F7"
      KeepAlive="True">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Width="470"
                    Margin="20"
                    Padding="35"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="White"
                    CornerRadius="18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20"
                                      ShadowDepth="3"
                                      Opacity="0.20"
                                      Color="#263238"/>
                </Border.Effect>
                <StackPanel>
                    <Image Width="90"
                           Height="90"
                           Margin="0,0,0,10"
                           Source="/Gushchina_Authorization;component/Resources/logo.png"
                           Stretch="Uniform"/>
                    <TextBlock Text="Вход в систему"
                               Margin="5,0,5,20"
                               HorizontalAlignment="Center"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#087F73"/>

                    <TextBlock Text="Логин"/>
                    <TextBox x:Name="TxtLogin"/>

                    <TextBlock Text="Пароль" Margin="5,12,5,5"/>
                    <Grid>
                        <PasswordBox x:Name="PswPassword"/>
                        <TextBox x:Name="TxtPasswordVisible"
                                 Visibility="Collapsed"/>
                    </Grid>
                    <CheckBox x:Name="ChkShowPassword"
                              Margin="5,7,0,0"
                              Content="Показать пароль"
                              Checked="ChkShowPassword_Checked"
                              Unchecked="ChkShowPassword_Unchecked"/>

                    <TextBlock x:Name="TxtAttempts"
                               Margin="5,10,5,0"
                               HorizontalAlignment="Center"
                               Foreground="#C62828"
                               FontWeight="SemiBold"
                               Visibility="Collapsed"/>

                    <StackPanel x:Name="CaptchaArea"
                                Margin="0,12,0,0"
                                Visibility="Collapsed">
                        <TextBlock Text="Введите символы с изображения"/>
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <Border Width="175"
                                    Height="44"
                                    Margin="5"
                                    Background="#E0F2F1"
                                    BorderBrush="#87AAA6"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                <TextBlock x:Name="TxtCaptchaText"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Consolas"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           TextDecorations="Strikethrough"/>
                            </Border>
                            <Button x:Name="BtnRefreshCaptcha"
                                    Width="95"
                                    Height="44"
                                    Content="Обновить"
                                    Click="BtnRefreshCaptcha_Click"/>
                        </StackPanel>
                        <TextBox x:Name="TxtCaptchaInput"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtTimer"
                               Margin="5,12,5,0"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="#C62828"
                               FontWeight="SemiBold"
                               Visibility="Collapsed"/>

                    <StackPanel Margin="0,20,0,0"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                        <Button x:Name="BtnEnterGuest"
                                Width="165"
                                Content="Войти как гость"
                                Click="BtnEnterGuest_Click"/>
                        <Button x:Name="BtnEnter"
                                Width="120"
                                Content="Войти"
                                Click="BtnEnter_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>

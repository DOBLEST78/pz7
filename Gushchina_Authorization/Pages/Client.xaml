<Page x:Class="Gushchina_Authorization.Pages.Client"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Страница клиента"
      Background="#F2F7F7">
    <Grid>
        <Border Width="500"
                Margin="20"
                Padding="35"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20"
                                  ShadowDepth="3"
                                  Opacity="0.20"
                                  Color="#263238"/>
            </Border.Effect>
            <StackPanel>
                <Image Width="110"
                       Height="110"
                       Margin="0,0,0,15"
                       Source="/Gushchina_Authorization;component/Resources/logo.png"
                       Stretch="Uniform"/>
                <TextBlock x:Name="TxtWelcome"
                           HorizontalAlignment="Center"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#087F73"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtRole"
                           Margin="5,12,5,5"
                           HorizontalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtDetails"
                           Margin="20,15,20,5"
                           FontSize="15"
                           LineHeight="25"
                           TextAlignment="Left"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
